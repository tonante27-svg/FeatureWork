<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Age_Between_1_and_100</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Age__c &gt; 100,Age__c &lt; 1)</errorConditionFormula>
    <errorDisplayField>Age__c</errorDisplayField>
    <errorMessage>Please add a valid age between 1 and 100.</errorMessage>
</ValidationRule>
