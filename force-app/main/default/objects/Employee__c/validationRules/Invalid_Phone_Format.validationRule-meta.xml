<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Invalid_Phone_Format</fullName>
    <active>true</active>
    <errorConditionFormula>NOT( REGEX(Mobile_Number__c, &quot;\\D*?(\\d\\D*?){10}&quot;))</errorConditionFormula>
    <errorDisplayField>Mobile_Number__c</errorDisplayField>
    <errorMessage>Invalid Phone Format. Please enter a valid phone number.</errorMessage>
</ValidationRule>
