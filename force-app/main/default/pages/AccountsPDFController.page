<apex:page style=l"ightningstylesheets" recordSetVar="Accounts" tabStyle="Account" extension="AccountsPDFConttroller" renderas="pdf">
<!-- Begin Default Content REMOVE THIS -->
 <apex:pageBlock title="Ordered List of Accounts">
   
       <apex:commandButton value="Email" action="{!sendEmail}" />
       <apex:pageBlockSection columns="1">
        <apex:pageBlockTable value="{!Accounts}" var="a">
            <apex:column value="{!a.Id}"/>
            <apex:column value="{!a.Name}"/>
            <apex:column value="{!a.BillingState}"/>
            <apex:column value="{!a.BillingCountry}"/>
        </apex:pageBlockTable>
        </apex:pageBlockSection>
    </apex:pageBlock>
</apex:page>